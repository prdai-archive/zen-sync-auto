#!/bin/bash
set -euo pipefail

# zensync — one-command Zen Browser sync (bookmarks, history, cookies, logins,
# workspaces, tabs, prefs) between machines, backed by a private GitHub repo
# instead of a cloud bucket. Uses your existing `gh auth login` session — no
# separate credentials, no encryption layer. Commits are made under a fixed
# Claude identity, not your real git identity.

# ─── Config ───────────────────────────────────────────────────────────
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zensync"
CONFIG_FILE="$CONFIG_DIR/config"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zensync/repo"
OS_NAME="$(uname -s)"

GIT_COMMIT_NAME="Claude"
GIT_COMMIT_EMAIL="noreply@anthropic.com"

# ─── Colors & UI ─────────────────────────────────────────────────────
R="\033[0m"
B="\033[1m"
D="\033[2m"
PURPLE="\033[38;2;147;130;220m"
GREEN="\033[38;2;130;200;160m"
RED="\033[38;2;210;100;120m"
YELLOW="\033[38;2;220;180;100m"
WHITE="\033[38;2;200;200;210m"

die()  { printf "${RED}${B} error${R} ${WHITE}%s${R}\n" "$*" >&2; exit 1; }
ok()   { printf "${GREEN}  ✓${R} ${WHITE}%s${R}\n" "$*"; }
fail() { printf "${RED}  ✗${R} ${WHITE}%s${R}\n" "$*" >&2; }
step() { printf "${PURPLE}%s${R} ${D}%s${R}\n" "$1" "$2"; }
dim()  { printf "${D}%s${R}\n" "$*"; }

header() {
    local label="zensync $1"
    local inner=33
    local pad=$(( (inner - ${#label}) / 2 ))
    local rpad=$(( inner - ${#label} - pad ))
    printf "\n"
    printf "${PURPLE}${B}  ╭─────────────────────────────────╮${R}\n"
    printf "${PURPLE}${B}  │${R}${B}%*s%s%*s${PURPLE}${B}│${R}\n" "$((pad))" "" "$label" "$((rpad))" ""
    printf "${PURPLE}${B}  ╰─────────────────────────────────╯${R}\n"
    printf "\n"
}

usage() {
    header "help"
    printf "${B}  Usage:${R}\n"
    printf "    ${WHITE}zensync${R}              ${D}Close Zen, pull+merge remote, push, reopen Zen${R}\n"
    printf "    ${WHITE}zensync${R} ${YELLOW}status${R}       ${D}Show last sync info${R}\n"
    printf "    ${WHITE}zensync${R} ${YELLOW}init${R}         ${D}Setup wizard (uses your gh auth session)${R}\n"
    printf "\n"
    printf "  ${D}Backed by a private GitHub repo, not a cloud bucket. Config: %s${R}\n" "$CONFIG_DIR/config"
    printf "\n"
    exit 0
}

# ─── Zen process management (macOS + Linux) ───────────────────────────
zen_proc_name() {
    if [[ "$OS_NAME" == "Darwin" ]]; then echo "zen"; else echo "zen-bin"; fi
}

zen_close_local() {
    local pids
    pids=$(pgrep -x "$(zen_proc_name)" 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
        step "  ◼" "Closing Zen..."
        kill -SIGTERM $(echo "$pids" | head -1) 2>/dev/null || true
        for _ in $(seq 1 10); do
            pgrep -x "$(zen_proc_name)" >/dev/null 2>&1 || break
            sleep 0.5
        done
    fi
}

zen_open_local() {
    step "  ▶" "Reopening Zen..."
    if [[ "$OS_NAME" == "Darwin" ]]; then
        open -a Zen
    else
        nohup zen-browser >/dev/null 2>&1 &
    fi
}

# ─── Resolve script + helper locations ────────────────────────────────
resolve_script_dir() {
    local dir
    dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -L "${BASH_SOURCE[0]}" ]]; then
        dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    fi
    echo "$dir"
}

SCRIPT_DIR="$(resolve_script_dir)"

find_py() {
    local name="$1"
    local path="$SCRIPT_DIR/$name"
    [[ -f "$path" ]] && { echo "$path"; return; }
    path="$HOME/.local/lib/zensync/$name"
    [[ -f "$path" ]] && { echo "$path"; return; }
    die "$name not found. Re-run install."
}

# ─── Profile discovery (macOS + Linux, incl. flatpak) ─────────────────
find_zen_dir() {
    local candidates=(
        "$HOME/Library/Application Support/zen/Profiles"
        "$HOME/.config/zen"
        "$HOME/.zen"
        "$HOME/.var/app/app.zen_browser.zen/.zen"
    )
    for d in "${candidates[@]}"; do
        [[ -d "$d" ]] && { echo "$d"; return; }
    done
    die "Zen Browser not found (tried ~/Library/Application Support/zen/Profiles, ~/.config/zen, ~/.zen and the flatpak path)"
}

find_local_profile() {
    local zen_dir
    zen_dir=$(find_zen_dir)

    local profiles=()
    while IFS= read -r d; do
        [[ -f "$d/zen-sessions.jsonlz4" ]] && profiles+=("$d")
    done < <(find "$zen_dir" -maxdepth 1 -type d -name "*.Default (release)" 2>/dev/null)

    if [[ ${#profiles[@]} -eq 0 ]]; then
        while IFS= read -r d; do
            [[ -f "$d/zen-sessions.jsonlz4" ]] && profiles+=("$d")
        done < <(find "$zen_dir" -maxdepth 1 -type d 2>/dev/null)
    fi

    [[ ${#profiles[@]} -gt 0 ]] || die "no Zen profile found with zen-sessions.jsonlz4"

    if [[ ${#profiles[@]} -eq 1 ]]; then
        echo "${profiles[0]}"
    else
        echo "Multiple profiles found:" >&2
        for i in "${!profiles[@]}"; do
            echo "  [$i] ${profiles[$i]}" >&2
        done
        read -rp "Select profile [0]: " choice
        echo "${profiles[${choice:-0}]}"
    fi
}

# ─── Config management ─────────────────────────────────────────────────
load_config() {
    [[ -f "$CONFIG_FILE" ]] || die "not configured. Run 'zensync init' first."
    source "$CONFIG_FILE"
    : "${GH_OWNER:?}" "${GH_REPO:?}" "${LOCAL_PROFILE:?}"
}

require_gh() {
    command -v gh >/dev/null 2>&1 || die "gh (GitHub CLI) not found. Install it: brew install gh"
    gh auth status >/dev/null 2>&1 || die "not logged in to gh. Run 'gh auth login' first."
}

gh_token() {
    gh auth token
}

# All git operations against the data repo pass the token as a transient
# extra header instead of embedding it in the remote URL or repo config, so
# it never gets persisted to disk.
git_data() {
    git -C "$DATA_DIR" -c "http.https://github.com/.extraheader=AUTHORIZATION: bearer $(gh_token)" "$@"
}

# ─── Files that are synced ─────────────────────────────────────────────
# Everything: workspaces/tabs/spaces, bookmarks+history, favicons, site
# permissions, UI layout (sidebar placement etc via prefs.js/xulstore.json),
# containers, cookies, and saved logins. Session/tab files get merged
# (merge.py); everything else is copied whichever side has newer content.
SYNC_FILES=(
    "zen-sessions.jsonlz4"
    "zen-sessions-backup/clean.jsonlz4"
    "sessionstore-backups/recovery.jsonlz4"
    "sessionstore-backups/recovery.baklz4"
    "sessionstore-backups/previous.jsonlz4"
    "prefs.js"
    "xulstore.json"
    "containers.json"
    "places.sqlite"
    "favicons.sqlite"
    "permissions.sqlite"
    "cookies.sqlite"
    "logins.json"
    "key4.db"
)

MERGE_FILES=(
    "zen-sessions.jsonlz4"
    "zen-sessions-backup/clean.jsonlz4"
    "sessionstore-backups/recovery.jsonlz4"
    "sessionstore-backups/recovery.baklz4"
    "sessionstore-backups/previous.jsonlz4"
)

is_merge_file() {
    local f="$1"
    for mf in "${MERGE_FILES[@]}"; do
        [[ "$f" == "$mf" ]] && return 0
    done
    return 1
}

mtime_of() {
    [[ -f "$1" ]] || { echo 0; return; }
    if [[ "$OS_NAME" == "Darwin" ]]; then
        stat -f %m "$1"
    else
        stat -c %Y "$1"
    fi
}

# Timestamp of the last commit that touched this path in the data repo.
repo_commit_time_of() {
    git_data log -1 --format=%ct -- "$1" 2>/dev/null || echo 0
}

copy_profile_into_repo() {
    for f in "${SYNC_FILES[@]}"; do
        local src="$LOCAL_PROFILE/$f"
        [[ -f "$src" ]] || continue
        local dst="$DATA_DIR/$f"
        mkdir -p "$(dirname "$dst")"
        cp -p "$src" "$dst"
    done
}

# ─── Init ─────────────────────────────────────────────────────────────
prompt() {
    local label="$1" default="${2:-}"
    if [[ -n "$default" ]]; then
        printf "  ${PURPLE}›${R} ${WHITE}%s${R} ${D}[%s]${R} " "$label" "$default"
    else
        printf "  ${PURPLE}›${R} ${WHITE}%s${R} " "$label"
    fi
}

cmd_init() {
    mkdir -p "$CONFIG_DIR" "$(dirname "$DATA_DIR")"
    header "init"

    step "  ⟳" "Checking gh auth..."
    require_gh
    local gh_user
    gh_user=$(gh api user --jq .login)
    ok "Logged in as $gh_user"

    printf "\n"
    step "  ⟳" "Finding local Zen profile..."
    local local_profile
    local_profile=$(find_local_profile)
    ok "Local: $(basename "$local_profile")"

    printf "\n"
    prompt "GitHub org/owner for the data repo" "prdai-archive"; read -r owner
    owner="${owner:-prdai-archive}"
    prompt "Repo name" "zensync-data"; read -r repo
    repo="${repo:-zensync-data}"

    printf "\n"
    if gh repo view "$owner/$repo" >/dev/null 2>&1; then
        ok "Repo $owner/$repo already exists — will use it"
    else
        step "  ⟳" "Creating private repo $owner/$repo..."
        gh repo create "$owner/$repo" --private \
            --description "Private data store for zensync (Zen Browser sync) — cookies, logins, bookmarks, tabs. Not for browsing." \
            >/dev/null || die "could not create $owner/$repo"
        ok "Created $owner/$repo (private)"
    fi

    printf "\n"
    step "  ⟳" "Setting up local clone..."
    rm -rf "$DATA_DIR"
    if git -c "http.https://github.com/.extraheader=AUTHORIZATION: bearer $(gh_token)" \
        clone --quiet "https://github.com/$owner/$repo.git" "$DATA_DIR" 2>/dev/null; then
        ok "Cloned existing data"
    else
        mkdir -p "$DATA_DIR"
        git -C "$DATA_DIR" init --quiet -b main
        git -C "$DATA_DIR" remote add origin "https://github.com/$owner/$repo.git"
        ok "Initialized empty data repo (first sync will push)"
    fi

    cat > "$CONFIG_FILE" <<CONF
GH_OWNER="$owner"
GH_REPO="$repo"
LOCAL_PROFILE="$local_profile"
CONF
    chmod 600 "$CONFIG_FILE"

    printf "\n"
    printf "  ${GREEN}${B}✓ Config saved${R}\n"
    dim "  Run 'zensync init' on your other machine (same owner/repo, own gh auth)."
    dim "  Then just run 'zensync' on either machine whenever you switch."
    printf "\n"
}

# ─── Sync (the one command) ────────────────────────────────────────────
cmd_sync() {
    load_config
    require_gh
    header "sync"

    zen_close_local

    [[ -d "$DATA_DIR/.git" ]] || die "data repo missing at $DATA_DIR. Run 'zensync init'."

    step "  ↓" "Pulling latest from $GH_OWNER/$GH_REPO..."
    git_data fetch --quiet origin main 2>/dev/null || true
    local remote_exists
    remote_exists=$(git_data rev-parse --verify origin/main 2>/dev/null || echo "")
    if [[ -n "$remote_exists" ]]; then
        git_data checkout --quiet -B main origin/main 2>/dev/null || \
            git_data reset --quiet --hard origin/main
        ok "Data repo up to date"

        if [[ -f "$DATA_DIR/zen-sessions.jsonlz4" ]]; then
            step "  ⇄" "Merging tabs & workspaces..."
            local merge_py
            merge_py=$(find_py "merge.py")
            [[ -f "$DATA_DIR/sessionstore-backups/recovery.jsonlz4" ]] && \
                cp "$DATA_DIR/sessionstore-backups/recovery.jsonlz4" "$DATA_DIR/recovery.jsonlz4"
            local merge_result
            merge_result=$(python3 "$merge_py" "$LOCAL_PROFILE" "$DATA_DIR" 2>/dev/null || echo '{}')
            local new_tabs new_spaces
            new_tabs=$(echo "$merge_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('new_tabs',0))" 2>/dev/null || echo 0)
            new_spaces=$(echo "$merge_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('new_spaces',0))" 2>/dev/null || echo 0)
            [[ "$new_tabs" -gt 0 || "$new_spaces" -gt 0 ]] && ok "Merged $new_tabs new tabs, $new_spaces new spaces" || dim "  Nothing new to merge"
        fi

        step "  ⇄" "Syncing everything else (cookies, logins, bookmarks, prefs)..."
        for f in "${SYNC_FILES[@]}"; do
            is_merge_file "$f" && continue
            local repo_f="$DATA_DIR/$f"
            local local_f="$LOCAL_PROFILE/$f"
            [[ -f "$repo_f" ]] || continue

            local repo_time local_mtime
            repo_time=$(repo_commit_time_of "$f")
            local_mtime=$(mtime_of "$local_f")

            if [[ "$repo_time" -gt "$local_mtime" ]]; then
                mkdir -p "$(dirname "$local_f")"
                cp -p "$repo_f" "$local_f"
                ok "$f (took remote, newer)"
            fi
        done
    else
        dim "  No remote data yet (first run) — will push local as-is."
    fi

    printf "\n"
    step "  ↑" "Writing merged profile into data repo..."
    copy_profile_into_repo
    git_data add -A

    if git_data diff --cached --quiet; then
        dim "  Nothing changed"
    else
        git_data -c user.name="$GIT_COMMIT_NAME" -c user.email="$GIT_COMMIT_EMAIL" \
            commit --quiet -m "sync from $(hostname) at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        ok "Committed"

        step "  ↑" "Pushing..."
        if ! git_data push --quiet -u origin main 2>/dev/null; then
            dim "  Push rejected (other device pushed first) — retrying with fresh state..."
            git_data fetch --quiet origin main
            git_data reset --quiet --hard origin/main
            copy_profile_into_repo
            git_data add -A
            if ! git_data diff --cached --quiet; then
                git_data -c user.name="$GIT_COMMIT_NAME" -c user.email="$GIT_COMMIT_EMAIL" \
                    commit --quiet -m "sync from $(hostname) at $(date -u +%Y-%m-%dT%H:%M:%SZ) [retry]"
                git_data push --quiet -u origin main || die "push failed after retry — check network/gh auth"
            fi
        fi
        ok "Pushed to $GH_OWNER/$GH_REPO"
    fi

    printf "\n"
    zen_open_local

    printf "\n  ${GREEN}${B}✓ Sync complete${R}\n\n"
}

# ─── Status ───────────────────────────────────────────────────────────
cmd_status() {
    load_config
    require_gh
    header "status"

    printf "  ${PURPLE}${B}LOCAL${R} ${D}(%s)${R}\n" "$(hostname)"
    printf "  ${D}%s${R}\n\n" "$LOCAL_PROFILE"

    printf "  ${PURPLE}${B}DATA REPO${R} ${D}(%s/%s)${R}\n" "$GH_OWNER" "$GH_REPO"
    if [[ ! -d "$DATA_DIR/.git" ]]; then
        fail "not cloned locally — run 'zensync init'"
        printf "\n"
        return
    fi
    git_data fetch --quiet origin main 2>/dev/null || true
    local last_commit
    last_commit=$(git_data log origin/main -1 --format="%s (%cr)" 2>/dev/null || echo "")
    if [[ -n "$last_commit" ]]; then
        dim "  Last sync: $last_commit"
    else
        dim "  No syncs yet"
    fi
    printf "\n"
}

# ─── Main ─────────────────────────────────────────────────────────────
case "${1:-sync}" in
    sync)   cmd_sync ;;
    status) cmd_status ;;
    init)   cmd_init ;;
    help|--help|-h) usage ;;
    *)      die "unknown command: $1. Run 'zensync help'" ;;
esac
